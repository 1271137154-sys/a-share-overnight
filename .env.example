# Copy this file to .env before changing configuration.
APP_NAME=A股尾盘选股
DATABASE_PATH=data/stock_selector.db
LOG_DIR=logs
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# Generate with: python -c "import hashlib; print(hashlib.sha256(b'your-password').hexdigest())"
ADMIN_PASSWORD_HASH=replace-with-a-sha256-hash
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=3
LOG_LEVEL=INFO
ENABLE_SCHEDULER=true
SCHEDULER_HOUR=14
SCHEDULER_MINUTE=40
